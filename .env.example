# Copy this file to a new file named exactly:  .env
# Then fill in your own values. The .env file stays on the local machine only.
# It is listed in .gitignore so it is never uploaded to GitHub.

# From your Weaviate Cloud Sandbox cluster (Details page)
WEAVIATE_URL=https://your-cluster-id.region.weaviate.cloud
WEAVIATE_API_KEY=paste-your-weaviate-admin-key-here

# From Google AI Studio (aistudio.google.com, "Get API key")
GEMINI_API_KEY=paste-your-gemini-key-here

# Settings you can leave as they are
GEMINI_MODEL=gemini-3.7-flash
COLLECTION_NAME=DocumentKnowledge
TOP_K=4
HYBRID_ALPHA=0.5
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
